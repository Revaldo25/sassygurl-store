# ============================================================================
# SassyGurl Store — Environment Variables
#
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file to version control.
# ============================================================================

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_DB=sassygurl
POSTGRES_USER=sassygurl_user
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ── JWT Authentication ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ── pgAdmin ──────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@sassygurl.store
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ── Provider APIs ────────────────────────────────────────────────────────
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
VIP_RESELLER_API_ID=
VIP_RESELLER_API_KEY=

# ── Payment Gateways ────────────────────────────────────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# ── Security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Notifications ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
FONNTE_API_TOKEN=

# ── Cloud Storage (Cloudinary) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=SassyGurlStore
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sync ─────────────────────────────────────────────────────────────────
SYNC_WEBHOOK_SECRET=

# ── Backup ───────────────────────────────────────────────────────────────
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_CLOUD_BUCKET=s3://sassygurl-backups
BACKUP_CLOUD_PROVIDER=s3
LOG_RETENTION_DAYS=30

# ── AWS (for S3 backup uploads) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
