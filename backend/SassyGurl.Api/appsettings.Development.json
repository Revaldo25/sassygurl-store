{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sassygurl;Username=postgres;Password=[PLACEHOLDER_DB_PASSWORD];Maximum Pool Size=20;Include Error Detail=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "[PLACEHOLDER_JWT_SECRET_32_CHARS!]",
    "Issuer": "SassyGurlStoreApi",
    "Audience": "SassyGurlStoreClients",
    "ExpireDays": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Midtrans": {
    "ServerKey": "[PLACEHOLDER_MIDTRANS_SERVER_KEY]"
  },
  "ProviderApis": {
    "DigiflazzBaseUrl": "https://api.digiflazz.com/v1/",
    "DigiflazzApiKey": "[PLACEHOLDER_DIGIFLAZZ_API_KEY]"
  },
  "Xendit": {
    "BaseUrl": "https://api.xendit.co/",
    "SecretApiKey": "[PLACEHOLDER_XENDIT_SECRET]",
    "WebhookToken": "[PLACEHOLDER_XENDIT_WEBHOOK_TOKEN]"
  },
  "Security": {
    "EncryptionMasterKey": "[PLACEHOLDER_ENCRYPTION_KEY_64_CHARS]"
  },
  "Pricing": {
    "MarginPercentage": 0.05,
    "FixedFee": 0
  },
  "VipReseller": {
    "ApiId": "[PLACEHOLDER_VIP_API_ID]",
    "ApiKey": "[PLACEHOLDER_VIP_API_KEY]"
  },
  "Digiflazz": {
    "Username": "[PLACEHOLDER_DIGIFLAZZ_USERNAME]",
    "ApiKey": "[PLACEHOLDER_DIGIFLAZZ_API_KEY]"
  },
  "Cloudinary": {
    "CloudName": "sassygurlstore",
    "ApiKey": "[PLACEHOLDER_CLOUDINARY_API_KEY]",
    "ApiSecret": "[PLACEHOLDER_CLOUDINARY_API_SECRET]"
  },
  "Telegram": {
    "BotToken": "[PLACEHOLDER_TELEGRAM_BOT_TOKEN]",
    "SupportBotToken": "[PLACEHOLDER_TELEGRAM_SUPPORT_BOT_TOKEN]",
    "AdminChatId": "[PLACEHOLDER_ADMIN_CHAT_ID]"
  },
  "Fonnte": {
    "ApiToken": "[PLACEHOLDER_FONNTE_TOKEN]"
  },
  "Sync": {
    "WebhookSecret": "[PLACEHOLDER_WEBHOOK_SECRET]",
    "IntervalHours": 6
  },
  "Features": {
    "EnableScheduledCatalogSync": true
  },
  "Vapid": {
    "Subject": "mailto:admin@sassygurlstore.com",
    "PublicKey": "[PLACEHOLDER_VAPID_PUBLIC_KEY]",
    "PrivateKey": "[PLACEHOLDER_VAPID_PRIVATE_KEY]"
  }
}
