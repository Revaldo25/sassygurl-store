# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@localhost:5432/sassygurl"

# Email Configuration
EMAIL_USER="[PLACEHOLDER_EMAIL_USER]"
EMAIL_PASS="[PLACEHOLDER_EMAIL_PASS]"

# MIDTRANS ACCESS KEYS (SANDBOX/PRODUCTION)
MIDTRANS_MERCHANT_ID="[PLACEHOLDER_MERCHANT_ID]"
MIDTRANS_CLIENT_KEY="[PLACEHOLDER_CLIENT_KEY]"
MIDTRANS_SERVER_KEY="[PLACEHOLDER_SERVER_KEY]"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="[PLACEHOLDER_CLIENT_KEY]"

# URL WEB ANDA
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SITE URL FOR SEO / OG TAGS (production domain)
NEXT_PUBLIC_SITE_URL="https://sassygurlstore.com"

# GOOGLE AUTH
GOOGLE_CLIENT_ID="[PLACEHOLDER_GOOGLE_CLIENT_ID]"
GOOGLE_CLIENT_SECRET="[PLACEHOLDER_GOOGLE_CLIENT_SECRET]"

# FACEBOOK AUTH
FACEBOOK_CLIENT_ID="[PLACEHOLDER_FACEBOOK_CLIENT_ID]"
FACEBOOK_CLIENT_SECRET="[PLACEHOLDER_FACEBOOK_CLIENT_SECRET]"

# FACEBOOK WEBHOOK
FB_WEBHOOK_VERIFY_TOKEN="[PLACEHOLDER_FB_VERIFY_TOKEN]"

# WEBHOOK SECRET
WEBHOOK_SECRET="[PLACEHOLDER_WEBHOOK_SECRET]"

# NEXTAUTH CONFIG
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="[PLACEHOLDER_NEXTAUTH_SECRET]"
AUTH_TRUST_HOST="true"

# ASP.NET CORE BACKEND API
NEXT_PUBLIC_API_URL="http://localhost:5009/api"

# DIGIFLAZZ (Jika dibutuhkan di backend Node/Edge)
Digiflazz__Username="[PLACEHOLDER_DIGIFLAZZ_USERNAME]"
Digiflazz__ApiKey="[PLACEHOLDER_DIGIFLAZZ_API_KEY]"
